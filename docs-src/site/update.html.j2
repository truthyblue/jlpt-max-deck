{% extends "_layouts/site.html.j2" %}
{% set absolute_links = false %}
{% set current_page = "update" %}
{% block head %}  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#08120e">
  <meta name="robots" content="index,follow">
  <meta name="description" content="JLPT MAX Deck을 기존 학습 기록과 개인 덱 옵션을 보존하며 업데이트하는 절차입니다.">
  <meta property="og:type" content="article">
  <meta property="og:locale" content="ko_KR">
  <meta property="og:title" content="업데이트 가이드 — JLPT MAX Deck">
  <meta property="og:description" content="학습 기록을 유지하면서 JLPT MAX덱을 새 버전으로 업데이트하는 방법입니다.">
  <meta property="og:url" content="{{ product.site_url }}/update.html">
  <meta property="og:image" content="{{ product.site_url }}/assets/social-card.jpg">
  <link rel="canonical" href="{{ product.site_url }}/update.html">
  <link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
  <title>업데이트 가이드 — JLPT MAX Deck</title>
{% endblock %}
{% block body_attributes %} class="v2-site"{% endblock %}
{% block main %}  <main class="v2-main" id="main" tabindex="-1">
    <section class="v2-page-hero">
      <div class="v2-shell">
        <p class="v2-kicker"><span></span>업데이트 가이드</p>
        <h1>학습 기록은 그대로,<br><em>덱만 새 버전으로.</em></h1>
        <p class="v2-hero-lead">먼저 모든 기기를 동기화한 뒤, 지금 쓰는 버전에 맞는 방법으로 덱을 다시 가져오세요.</p>
        <div class="v2-page-badges"><span>현재 {{ release.tag }}</span><span>기록 유지</span><span>개인 설정 보존</span></div>
      </div>
    </section>

    <div class="v2-shell v2-guide-layout">
      <aside class="v2-guide-toc" aria-label="업데이트 목차">
        <strong>업데이트 순서</strong>
        <ol>
          <li><a href="#before">동기화·백업</a></li>
          <li><a href="#ordinary">일반 업데이트</a></li>
          <li><a href="#import-options">가져오기 옵션</a></li>
          <li><a href="#recommended-settings">업데이트 뒤 설정</a></li>
          <li><a href="#verify">업데이트 확인</a></li>
        </ol>
      </aside>

      <div class="v2-guide-content">
        <section class="v2-guide-section" id="before">
          <span class="v2-step-label">00 · 먼저</span>
          <h2>먼저 모든 기기를 동기화하세요.</h2>
          <p>여러 기기를 쓴다면 각 기기의 최신 복습 기록이 AnkiWeb에 반영됐는지 확인합니다. 가능하면 컬렉션 백업도 확인하세요.</p>
          <div class="v2-callout warning"><strong>최상위 <code>JLPT MAX덱</code>을 삭제하지 마세요.</strong><p>기존 카드와 학습 일정은 그대로 두고 새 덱 파일을 가져오면 됩니다.</p></div>
        </section>

        <section class="v2-guide-section" id="ordinary">
          <span class="v2-step-label">01 · 일반 업데이트</span>
          <h2>기존 덱을 지우지 말고 새 파일을 가져오세요.</h2>
          <div class="v2-download-card">
            <div><small>현재 기본 덱</small><h3>{{ release.artifacts.core.filename }}</h3><p>{{ release.tag }} · 약 {{ product.requirements.approximate_apkg_size_gb }}GB</p></div>
            <a class="v2-button" href="{{ product.repository_url }}/releases/download/{{ release.tag }}/{{ release.artifacts.core.filename }}">다시 받기 <span aria-hidden="true">↓</span></a>
          </div>
          <p>새 덱 파일을 가져오면 기존 학습 기록과 일정은 유지되고, 새 노트와 바뀐 카드 내용만 반영됩니다. 새 버전에서 없어진 카드가 있다면 해당 릴리스의 추가 안내를 따르세요.</p>
        </section>

        <section class="v2-guide-section" id="import-options">
          <span class="v2-step-label">02 · 가져오기 옵션</span>
          <h2>복습 기록은 유지하고 카드 내용만 새로 바꿉니다.</h2>
          <div class="v2-option-grid">
            <article class="v2-option"><div class="v2-option-head"><h3>학습 진행 상태</h3><span class="v2-state off">끄기</span></div><p>기존 복습 기록과 일정을 그대로 둡니다.</p></article>
            <article class="v2-option"><div class="v2-option-head"><h3>기존 노트 업데이트</h3><span class="v2-state on">항상</span></div><p>v1.2.0의 고저 악센트 필드와 새 카드 템플릿을 기존 노트에 적용합니다.</p></article>
            <article class="v2-option"><div class="v2-option-head"><h3>노트 유형 병합</h3><span class="v2-state on">켜기</span></div><p>기존 노트 유형을 새 버전과 연결합니다.</p></article>
            <article class="v2-option"><div class="v2-option-head"><h3>개인 덱 옵션</h3><span class="v2-state">보존</span></div><p>직접 바꾼 새 카드 수와 FSRS 설정을 그대로 둡니다.</p></article>
          </div>
          <table class="v2-release-facts">
            <thead><tr><th scope="col">지금 사용하는 버전</th><th scope="col">기존 노트 업데이트</th><th scope="col">이유</th></tr></thead>
            <tbody>
              <tr><th scope="row">v1.1.x</th><td><strong>항상</strong></td><td>고저 악센트 필드와 새 카드 템플릿을 적용합니다.</td></tr>
              <tr><th scope="row">v1.0.x</th><td><strong>항상</strong></td><td>v1.1.x의 뜻·예문 변경과 v1.2.0의 새 필드를 함께 적용합니다.</td></tr>
            </tbody>
          </table>
          <div class="v2-callout warning"><strong>v1.2.0은 어느 기존 버전에서 오더라도 <code>항상</code>을 선택하세요.</strong><p><code>항상</code>은 직접 수정한 공식 노트 필드도 덮어쓸 수 있으므로 먼저 동기화하거나 백업하세요. 다음 업데이트에서는 출발 버전에 따라 옵션이 달라질 수 있으므로 그 버전의 릴리스 노트에 적힌 표를 따릅니다.</p></div>
        </section>

        <section class="v2-guide-section" id="recommended-settings">
          <span class="v2-step-label">03 · 설정</span>
          <h2>업데이트한 뒤에는 실전 설정만 확인하세요.</h2>
          <p>개인 설정은 그대로 유지됩니다. 음성 덱의 새 카드 수를 포함한 나머지 옵션은 지금 설정을 그대로 두세요.</p>
          <div class="v2-option-grid v2-option-grid-single">
            <article class="v2-option"><div class="v2-option-head"><h3>JLPT MAX덱 · 실전</h3><span class="v2-state on">무작위 노트</span></div><p><strong>신규 카드 수집</strong>을 <code>무작위 노트</code>로 바꿉니다. 급수 덱을 눌렀을 때 문제 유형이 섞여 나옵니다.</p></article>
          </div>
        </section>

        <section class="v2-guide-section" id="verify">
          <span class="v2-step-label">04 · 확인</span>
          <h2>업데이트가 잘 됐는지 확인하세요.</h2>
          <ol class="v2-step-list">
            <li><div><strong>전에 공부한 어휘 몇 장의 복습 일정이 그대로인지 확인합니다.</strong></div></li>
            <li><div><strong>새 카드 내용과 템플릿이 반영됐는지 확인합니다.</strong></div></li>
            <li><div><strong>실전의 신규 카드 수집이 무작위 노트인지 확인합니다.</strong></div></li>
            <li><div><strong>기존 한자 확장은 다시 만들지 않아도 됩니다.</strong><p>한자 카드에도 새 일본어 글꼴 설정과 최신 연결 어휘 표시를 반영하고 싶을 때만 v1.2.0 빌더로 다시 만들어 같은 옵션으로 가져옵니다.</p></div></li>
            <li><div><strong>가져오기가 끝나면 모든 기기에서 다시 전체 동기화합니다.</strong></div></li>
          </ol>
          <div class="v2-hero-actions"><a class="v2-button" href="study-guide.html">덱 학습법 보기 <span aria-hidden="true">→</span></a><a class="v2-button v2-button-ghost" href="support.html#import">업데이트 문제 해결 <span aria-hidden="true">→</span></a></div>
        </section>
      </div>
    </div>
  </main>
{% endblock %}
