{
  "latest_version": "{{ release.version }}",
  "schema_version": 1,
{%- if product.app_launch %}
  "app_launch": {{ product.app_launch | tojson }},
{%- endif %}
{#- update_summary replaces the in-deck update line for its own release only, so a later release falls back to its history summary. #}
{%- set feed_summary = product.update_summary.text if product.update_summary and product.update_summary.version == release.version else release_history[0].summary %}
  "summary": {{ feed_summary | tojson }}
}
