    <div class="v2-shell v2-guide-layout">
      <aside class="v2-guide-toc" aria-label="도움말 목차">
        <strong>도움말</strong>
        <ol>
          <li><a href="#faq">자주 묻는 질문</a></li>
          <li><a href="#device">소리·화면·내 기록</a></li>
