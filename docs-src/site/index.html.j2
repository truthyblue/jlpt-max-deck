{% set absolute_links = false -%}
{% set current_page = "index" -%}
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0c1210">
  <meta name="robots" content="index,follow">
  <meta name="description" content="{{ product.deck.vocabulary_notes | number }}개 선별 어휘와 {{ product.deck.practice_notes | number }}개 실전 문제를 담은 JLPT Anki 덱. GPT‑5.6 Sol로 작성하고 이중 검토한 콘텐츠를 수록했습니다.">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ko_KR">
  <meta property="og:site_name" content="JLPT MAX Deck">
  <meta property="og:title" content="JLPT MAX Deck — 단어는 더 깊이, 실전 문제까지">
  <meta property="og:description" content="실제 카드와 GPT‑5.6 Sol 작성·이중 검토 과정을 확인하고 기본 덱을 받아보세요.">
  <meta property="og:url" content="{{ product.site_url }}">
  <meta property="og:image" content="{{ product.site_url }}/assets/social-card.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="JLPT MAX Deck — 단어는 더 깊이, 실전 문제까지">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="JLPT MAX Deck — 단어는 더 깊이, 실전 문제까지">
  <meta name="twitter:description" content="{{ product.deck.vocabulary_notes | number }}개 어휘와 {{ product.deck.practice_notes | number }}개 실전 문제를 담은 JLPT MAX 기본 덱">
  <meta name="twitter:image" content="{{ product.site_url }}/assets/social-card.jpg">
  <meta name="twitter:image:alt" content="JLPT MAX Deck — 단어는 더 깊이, 실전 문제까지">
  <link rel="canonical" href="{{ product.site_url }}">
  <title>JLPT MAX Deck — 단어는 더 깊이, 실전 문제까지</title>
  <link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="assets/showcase.css?v={{ asset_versions.showcase_css }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ product.site_url }}#website",
        "url": "{{ product.site_url }}",
        "name": "JLPT MAX Deck",
        "description": "한국어권 JLPT 학습자를 위한 공개 Anki 덱",
        "inLanguage": "ko-KR"
      },
      {
        "@type": "SoftwareApplication",
        "name": "JLPT MAX Deck",
        "softwareVersion": "{{ release.version }}",
        "applicationCategory": "EducationalApplication",
        "operatingSystem": "Anki",
        "downloadUrl": "{{ product.repository_url }}/releases/download/{{ release.tag }}/{{ release.artifacts.core.filename }}",
        "url": "{{ product.site_url }}"
      }
    ]
  }
  </script>
</head>
<body>
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>

{% include "_components/nav.html.j2" %}

  <main id="main" tabindex="-1">
    <section class="hero" id="top">
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="hero-glyphs" aria-hidden="true">語&nbsp;習&nbsp;解&nbsp;進</div>
      <div class="hero-copy reveal">
        <h1>단어는 더 깊이,<br><em>실전 문제까지.</em></h1>
        <p class="hero-lead">
          JLPT 단어를 뜻만 외우지 않도록 예문·음성·활용·관련어와 실전 문제까지 연결한
          한국어권 학습자용 Anki 덱입니다. 기본 덱은 바로 받을 수 있습니다.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" id="release-cta" href="{{ product.repository_url }}/releases/download/{{ release.tag }}/{{ release.artifacts.core.filename }}"><span>기본 덱 다운로드</span><svg class="button-download-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v1.5A2.5 2.5 0 0 0 7.5 21h9a2.5 2.5 0 0 0 2.5-2.5V17"/></svg></a>
          <a class="button button-quiet" id="hero-beginner-guide-link" href="getting-started.html">시작 가이드 보기 <span class="button-arrow-icon" aria-hidden="true">→</span></a>
        </div>
        <p class="microcopy">N5–N1 · 기본 덱 노트 {{ product.deck.core_notes | number }}개 · 카드 {{ product.deck.core_cards | number }}개<br><a class="hero-install-link" href="install-anki.html">Anki가 없다면 설치 안내 보기 <span aria-hidden="true">→</span></a></p>
        <p class="microcopy"><strong>1.0.0 사용자:</strong> <code>종합 실전</code>만 삭제한 뒤 1.0.1을 가져오세요. <a class="hero-install-link" href="{{ product.repository_url }}/releases/tag/{{ release.tag }}">교정 업데이트 안내 <span aria-hidden="true">→</span></a></p>
      </div>

      <figure class="hero-card-sample reveal">
        <div class="sample-topline">
          <span class="live-dot" aria-hidden="true"></span>
          <span>카드 화면 샘플</span>
          <strong><span lang="ja">出す</span> · N5</strong>
        </div>
        <div class="hero-card-window">
          <img src="assets/card-dasu-answer.webp" width="640" height="1377" decoding="async" fetchpriority="high" data-showcase-state="kanji-expanded" alt="오른쪽 위 재생 메뉴와 出す의 읽기, 한국어 뜻, 예문, 활용, 관련어, 버튼 아래에 펼쳐진 出 한자 정보(나올 출·시작할 출, 부수·5획, 음독·훈독)를 보여주는 실제 JLPT MAX 어휘 카드 샘플">
        </div>
      </figure>
    </section>

    <section class="signal-bar" aria-label="덱 핵심 수치">
      <div><strong>{{ product.deck.vocabulary_notes | number }}</strong><span>선별 어휘</span></div>
      <div><strong>{{ product.deck.example_count | number }}</strong><span>검토된 예문</span></div>
      <div><strong>{{ product.deck.practice_notes | number }}</strong><span>실전 문제</span></div>
      <div><strong>{{ product.deck.core_cards | number }}</strong><span>기본 덱 카드</span></div>
    </section>

    <section class="section meaning-focus" id="meaning-focus" aria-labelledby="meaning-focus-title">
      <div class="meaning-focus-layout">
        <div class="meaning-focus-copy reveal">
          <span>학습할 뜻</span>
          <h2 id="meaning-focus-title">외울 뜻이<br>선명하도록.</h2>
          <p>사전의 설명을 많이 보여주기보다, 카드에서 실제로 구분해 외울 의미 단위를 먼저 정리했습니다. 무엇을 외워야 하는지 바로 보이고, 예문도 그 뜻을 이해하는 데 필요한 만큼만 연결했습니다.</p>
        </div>
        <ol class="meaning-focus-list">
          <li class="reveal">
            <b>01</b>
            <div class="meaning-focus-sample meaning-focus-merge"><span>엄마, 어머니</span><i>→</i><span>엄마</span></div>
            <h3>겹치는 표현은 하나로</h3>
            <p>같은 뜻을 가리키는 한국어 표현은 대표 표현 하나로 정리했습니다.</p>
          </li>
          <li class="reveal">
            <b>02</b>
            <div class="meaning-focus-sample meaning-focus-senses"><span>꺼내다</span><i>/</i><span>제출하다</span><i>/</i><span>편지를 보내다</span></div>
            <h3>다의어는 뜻별로 분리</h3>
            <p>구분해서 외워야 하는 뜻은 서로 나눠, 중요한 다의어가 다른 표현에 묻히지 않게 했습니다.</p>
          </li>
          <li class="reveal">
            <b>03</b>
            <div class="meaning-focus-sample meaning-focus-pairs">
              <div><span>뜻 1</span><i>→</i><span>예문 1</span></div>
              <div><span>뜻 2</span><i>→</i><span>예문 2</span></div>
            </div>
            <h3>각 뜻에 대표 예문 하나</h3>
            <p>각 뜻에는 그 의미가 분명하게 드러나는 대표 예문 하나를 생성해 연결했습니다.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="section card-showcase" id="cards">
      <div class="section-heading reveal">
        <h2>한 단어를<br>더 깊이 익히는 카드.</h2>
        <p>단어의 읽기와 뜻만 보여주는 카드에 예문과 활용, 관련어와 한자 정보까지 더했습니다.</p>
      </div>

      <div class="anatomy-layout">
        <div class="main-card-column">
          <figure class="anki-frame main-card-render reveal">
            <div class="card-audio-guide" id="card-audio-guide">
              <span class="guide-pulse" aria-hidden="true"></span>
              <span><strong>단어와 예문 1·2·3을 눌러보세요</strong><small>실제 카드처럼 각각의 음성이 재생됩니다</small></span>
              <b aria-hidden="true">↓</b>
            </div>
            <div class="interactive-card-image">
              <img src="assets/card-dasu-answer.webp" width="640" height="1377" loading="lazy" decoding="async" data-showcase-state="kanji-expanded" alt="오른쪽 위 재생 메뉴와 出す의 한국어 뜻, 예문, 활용, 관련어, 버튼 아래에 펼쳐진 出 한자 정보(나올 출·시작할 출, 부수·5획, 음독·훈독)를 보여주는 실제 어휘 답안 카드 샘플">
              <span class="card-feature-callout autoplay-feature-callout">
                <span class="card-feature-label"><strong>자동재생 설정</strong></span>
              </span>
              <span class="card-feature-callout conjugation-feature-callout">
                <span class="card-feature-label"><strong>활용</strong><small>ます·ない·て·た형을 한눈에</small></span>
              </span>
              <span class="card-feature-callout related-feature-callout">
                <span class="card-feature-label"><strong>헷갈리는 단어</strong><small>비슷한 표현을 뜻과 함께 비교</small></span>
              </span>
              <span class="card-feature-callout kanji-feature-callout">
                <span class="card-feature-label"><strong>한자 정보</strong><small>뜻·읽기·부수·획수까지</small></span>
              </span>
              <button class="card-audio-hotspot word-audio-hotspot" type="button" data-audio="dasu-word-audio" data-audio-name="단어 出す" data-idle-state="단어 듣기" data-playing-state="재생 중" data-ended-state="다시 듣기" data-play-label="단어 出す 음성 재생" data-pause-label="단어 出す 음성 일시정지" aria-controls="dasu-word-audio" aria-describedby="card-audio-guide" aria-label="단어 出す 음성 재생" aria-pressed="false">
                <span class="hotspot-badge"><span class="audio-play" aria-hidden="true">▶</span><span class="audio-state">단어 듣기</span></span>
              </button>
              <button class="card-audio-hotspot example-audio-hotspot example-1-audio-hotspot" type="button" data-audio="dasu-example-1-audio" data-audio-name="첫 번째 예문" data-idle-state="예문 1 듣기" data-playing-state="재생 중" data-ended-state="다시 듣기" data-play-label="첫 번째 예문 かばんから財布を出す。 음성 재생" data-pause-label="첫 번째 예문 かばんから財布を出す。 음성 일시정지" aria-controls="dasu-example-1-audio" aria-describedby="card-audio-guide" aria-label="첫 번째 예문 かばんから財布を出す。 음성 재생" aria-pressed="false">
                <span class="hotspot-badge"><span class="audio-play" aria-hidden="true">▶</span><span class="audio-state">예문 1 듣기</span></span>
              </button>
              <button class="card-audio-hotspot example-audio-hotspot example-2-audio-hotspot" type="button" data-audio="dasu-example-2-audio" data-audio-name="두 번째 예문" data-idle-state="예문 2 듣기" data-playing-state="재생 중" data-ended-state="다시 듣기" data-play-label="두 번째 예문 先生にレポートを出す。 음성 재생" data-pause-label="두 번째 예문 先生にレポートを出す。 음성 일시정지" aria-controls="dasu-example-2-audio" aria-describedby="card-audio-guide" aria-label="두 번째 예문 先生にレポートを出す。 음성 재생" aria-pressed="false">
                <span class="hotspot-badge"><span class="audio-play" aria-hidden="true">▶</span><span class="audio-state">예문 2 듣기</span></span>
              </button>
              <button class="card-audio-hotspot example-audio-hotspot example-3-audio-hotspot" type="button" data-audio="dasu-example-3-audio" data-audio-name="세 번째 예문" data-idle-state="예문 3 듣기" data-playing-state="재생 중" data-ended-state="다시 듣기" data-play-label="세 번째 예문 駅へ行く前に、この手紙を出す予定だ。 음성 재생" data-pause-label="세 번째 예문 駅へ行く前に、この手紙を出す予定だ。 음성 일시정지" aria-controls="dasu-example-3-audio" aria-describedby="card-audio-guide" aria-label="세 번째 예문 駅へ行く前に、この手紙を出す予定だ。 음성 재생" aria-pressed="false">
                <span class="hotspot-badge"><span class="audio-play" aria-hidden="true">▶</span><span class="audio-state">예문 3 듣기</span></span>
              </button>
            </div>
            <audio id="dasu-word-audio" src="assets/demo-dasu-word.mp3" preload="none"></audio>
            <audio id="dasu-example-1-audio" src="assets/demo-dasu-example.mp3" preload="none"></audio>
            <audio id="dasu-example-2-audio" src="assets/demo-dasu-example-2.mp3" preload="none"></audio>
            <audio id="dasu-example-3-audio" src="assets/demo-dasu-example-3.mp3" preload="none"></audio>
            <p class="sr-only" id="audio-demo-status" aria-live="polite"></p>
            <figcaption><span>대표 카드 · <span lang="ja">出す</span> · 기능 설명용 샘플<small>비공식 합성 음성 · AivisSpeech 1.2.0 · <span lang="ja">まい</span> · ACML 1.0</small></span><a class="main-card-zoom" href="assets/card-dasu-answer.webp" target="_blank" rel="noopener noreferrer" aria-label="대표 어휘 카드 이미지를 원본 크기로 보기 (새 탭)">크게 보기 ↗</a></figcaption>
          </figure>
        </div>
        <div class="feature-callouts">
          <article class="reveal">
            <span>01</span>
            <div><h3>음성과 자동재생</h3><p>단어와 예문마다 음성을 넣고, 오른쪽 위 <strong>재생</strong> 메뉴에서 단어만·첫 예문까지·모든 예문까지 중 자동재생 범위를 선택합니다.</p></div>
          </article>
          <article class="reveal">
            <span>02</span>
            <div><h3>뜻마다 대표 예문</h3><p><span lang="ja">出す</span>의 <strong>꺼내다 / 제출하다 / 편지를 보내다</strong>처럼 구분해서 외울 뜻마다 검토한 대표 예문과 한국어 번역을 연결했습니다.</p></div>
          </article>
          <article class="reveal">
            <span>03</span>
            <div><h3>한눈에 보는 활용</h3><p><span lang="ja">出します · 出さない · 出して · 出した</span>를 같은 카드에서 확인합니다.</p></div>
          </article>
          <article class="reveal">
            <span>04</span>
            <div><h3>관련어와 헷갈리는 단어</h3><p><span lang="ja">飛び出す</span>(뛰쳐나가다) · <span lang="ja">送る</span>(보내다)처럼 함께 구분할 어휘를 뜻과 함께 보여줍니다.</p></div>
          </article>
          <article class="reveal">
            <span>05</span>
            <div><h3>한자 정보를 바로</h3><p>단어를 이루는 한자의 뜻·읽기·부수·획수를 펼쳐서 확인합니다.</p></div>
          </article>
          <article class="reveal">
            <span>06</span>
            <div><h3>덱 안내와 업데이트</h3><p>카드 아래의 <strong>덱 안내 · 업데이트 ↗</strong> 링크에서 사용법과 새 소식을 확인합니다.</p></div>
          </article>
        </div>
      </div>

      <p class="public-sample-note reveal">아래 이미지는 실제 기본 덱 카드에서 가져온 샘플입니다.</p>

      <div class="support-card-grid" role="region" aria-label="다른 카드 기능 샘플 3개" tabindex="0">
        <figure class="mini-card-sample support-usage-sample reveal">
          <figcaption>
            <span class="support-feature-name">핵심 용법</span>
            <h3><span lang="ja">本当</span><small><span lang="ja">ほんとう</span> · 정말이다</small></h3>
            <p>핵심 표현을 비슷한 말과 함께 비교해, 뜻만으로 놓치기 쉬운 쓰임 차이를 구분합니다.</p>
          </figcaption>
          <a class="mini-card-crop" href="assets/card-hontou-usage.webp" target="_blank" rel="noopener noreferrer" aria-label="本当 핵심 용법 카드 이미지를 원본 크기로 보기 (새 탭)">
            <img src="assets/card-hontou-usage.webp" width="640" height="811" loading="lazy" decoding="async" alt="本当은 정말이다라는 뜻이며, 핵심 용법 패널에서 本当だと思う와 信じている의 뜻을 비교하는 현재 어휘 카드 샘플">
            <span class="support-focus support-focus-usage" aria-hidden="true"></span>
            <span class="support-zoom-hint" aria-hidden="true">크게 보기 ↗</span>
          </a>
        </figure>
        <figure class="mini-card-sample support-formation-sample reveal">
          <figcaption>
            <span class="support-feature-name">단어 구성</span>
            <h3><span lang="ja">半日</span><small><span lang="ja">はんにち</span> · 반나절</small></h3>
            <p>단어를 구성 요소로 나눠, 각 요소가 전체 뜻으로 이어지는 방식을 익힙니다.</p>
          </figcaption>
          <a class="mini-card-crop" href="assets/card-hannichi-formation.webp" target="_blank" rel="noopener noreferrer" aria-label="半日 단어 구성 카드 이미지를 원본 크기로 보기 (새 탭)">
            <img src="assets/card-hannichi-formation.webp" width="640" height="683" loading="lazy" decoding="async" alt="半日は 반나절이라는 뜻이며, 접두 요소 半은 반, 어근 日은 날 또는 날짜라는 뜻으로 나누어 보여주는 현재 어휘 카드 샘플">
            <span class="support-focus support-focus-formation" aria-hidden="true"></span>
            <span class="support-zoom-hint" aria-hidden="true">크게 보기 ↗</span>
          </a>
        </figure>
        <figure class="mini-card-sample support-register-sample reveal">
          <figcaption>
