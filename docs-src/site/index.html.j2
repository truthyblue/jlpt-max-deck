  <script>
    (() => {
      document.documentElement.classList.add('motion-ready');
      const audioButtons = Array.from(document.querySelectorAll('[data-audio]'));
      const audioStatus = document.getElementById('audio-demo-status');
      const setAudioButtonState = (button, isPlaying, hasEnded = false) => {
        button.classList.toggle('is-playing', isPlaying);
        button.setAttribute('aria-pressed', String(isPlaying));
        button.setAttribute('aria-label', isPlaying ? button.dataset.pauseLabel : button.dataset.playLabel);
        const icon = button.querySelector('.audio-play');
        const state = button.querySelector('.audio-state');
        if (icon) icon.textContent = isPlaying ? 'Ⅱ' : '▶';
        if (state) state.textContent = isPlaying
          ? button.dataset.playingState
          : (hasEnded ? button.dataset.endedState : button.dataset.idleState);
      };
      let boundAudioButtons = 0;
      audioButtons.forEach((button) => {
        const audio = document.getElementById(button.dataset.audio);
        if (!(audio instanceof HTMLAudioElement)) return;
        boundAudioButtons += 1;
        button.addEventListener('click', async () => {
          const shouldPlay = audio.paused;
          audioButtons.forEach((otherButton) => {
            const otherAudio = document.getElementById(otherButton.dataset.audio);
            if (otherAudio instanceof HTMLAudioElement && otherAudio !== audio) {
              otherAudio.pause();
              otherAudio.currentTime = 0;
            }
            if (otherButton !== button) setAudioButtonState(otherButton, false);
          });
          if (!shouldPlay) {
            audio.pause();
            setAudioButtonState(button, false);
            if (audioStatus) audioStatus.textContent = `${button.dataset.audioName} 음성을 일시정지했습니다.`;
            return;
          }
          try {
            audio.currentTime = 0;
            await audio.play();
            setAudioButtonState(button, true);
            if (audioStatus) audioStatus.textContent = `${button.dataset.audioName} 음성을 재생합니다.`;
          } catch (_error) {
            setAudioButtonState(button, false);
            if (audioStatus) audioStatus.textContent = `${button.dataset.audioName} 음성을 재생하지 못했습니다.`;
          }
        });
        audio.addEventListener('ended', () => {
          setAudioButtonState(button, false, true);
          if (audioStatus) audioStatus.textContent = `${button.dataset.audioName} 음성 재생이 끝났습니다.`;
        });
      });
      if (boundAudioButtons === audioButtons.length && boundAudioButtons > 0) {
        document.documentElement.classList.add('audio-demo-ready');
      }

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const focusCarouselSlide = (slide) => {
        const carousel = slide.closest('[data-carousel]');
        if (!(carousel instanceof HTMLElement)) return;
        const carouselRect = carousel.getBoundingClientRect();
        const slideRect = slide.getBoundingClientRect();
        const scrollPadding = parseFloat(getComputedStyle(carousel).scrollPaddingLeft) || 0;
        const visibleLeft = carouselRect.left + scrollPadding;
        const visibleRight = carouselRect.right - scrollPadding;
        if (slideRect.left >= visibleLeft - 2 && slideRect.right <= visibleRight + 2) return;
        const maxScroll = Math.max(0, carousel.scrollWidth - carousel.clientWidth);
        const target = carousel.scrollLeft + slideRect.left - visibleLeft;
        carousel.scrollTo({
          left: Math.max(0, Math.min(target, maxScroll)),
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        });
      };

      document.querySelectorAll('[data-flip-card]').forEach((button) => {
        const slide = button.closest('.practice-slide');
        const inner = slide?.querySelector('.practice-card-inner');
        const front = slide?.querySelector('.practice-card-front');
        const back = slide?.querySelector('.practice-card-back');
        const state = slide?.querySelector('.practice-flip-announcement');
        const answerLink = slide?.querySelector('.practice-answer-link');
        if (!(button instanceof HTMLButtonElement) || !slide || !inner || !front || !back || !state || !(answerLink instanceof HTMLAnchorElement)) return;

        const syncFlipHeight = (face) => {
          const height = face.offsetHeight;
          if (height > 0) slide.style.setProperty('--practice-card-height', `${height}px`);
        };
        const syncActiveFlipHeight = () => {
          const showAnswer = button.getAttribute('aria-expanded') === 'true';
          syncFlipHeight(showAnswer ? back : front);
        };

        syncFlipHeight(front);
        back.hidden = false;
        slide.classList.add('is-flip-ready');
        window.requestAnimationFrame(syncActiveFlipHeight);
        if ('ResizeObserver' in window) {
          const resizeObserver = new ResizeObserver(syncActiveFlipHeight);
          resizeObserver.observe(front);
          resizeObserver.observe(back);
        } else {
          window.addEventListener('resize', syncActiveFlipHeight);
        }

        button.addEventListener('click', () => {
          if (document.activeElement !== button) focusCarouselSlide(slide);
          const showAnswer = button.getAttribute('aria-expanded') !== 'true';
          button.setAttribute('aria-expanded', String(showAnswer));
          button.setAttribute('aria-label', showAnswer ? button.dataset.showQuestionLabel : button.dataset.showAnswerLabel);
          front.setAttribute('aria-hidden', String(showAnswer));
          back.setAttribute('aria-hidden', String(!showAnswer));
          answerLink.hidden = !showAnswer;
          syncFlipHeight(showAnswer ? back : front);
          state.textContent = showAnswer ? '정답·해설 면' : '문제 면';
          slide.classList.toggle('is-flipped', showAnswer);
        });
      });

      document.querySelectorAll('[data-carousel]').forEach((carousel) => {
        const previous = document.querySelector(`[data-carousel-prev][aria-controls="${carousel.id}"]`);
        const next = document.querySelector(`[data-carousel-next][aria-controls="${carousel.id}"]`);
        const status = document.getElementById(`${carousel.id}-status`);
        const slides = Array.from(carousel.querySelectorAll('.practice-slide'));
        if (!(previous instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement) || slides.length === 0) return;

        let currentSlideIndex = 0;
        let updateFrame = 0;

        const updateControls = () => {
          const maxScroll = Math.max(0, carousel.scrollWidth - carousel.clientWidth);
          previous.disabled = carousel.scrollLeft <= 2;
          next.disabled = carousel.scrollLeft >= maxScroll - 2;
        };
        const updateCurrentSlide = () => {
          const carouselRect = carousel.getBoundingClientRect();
          const scrollPadding = parseFloat(getComputedStyle(carousel).scrollPaddingLeft) || 0;
          const targetLeft = carouselRect.left + scrollPadding;
          let nearestIndex = 0;
          let nearestDistance = Number.POSITIVE_INFINITY;
          slides.forEach((slide, index) => {
            const distance = Math.abs(slide.getBoundingClientRect().left - targetLeft);
            if (distance < nearestDistance) {
              nearestDistance = distance;
              nearestIndex = index;
            }
          });
          if (nearestIndex === currentSlideIndex) return;
          currentSlideIndex = nearestIndex;
          slides.forEach((slide, index) => {
            if (index === currentSlideIndex) slide.setAttribute('aria-current', 'true');
            else slide.removeAttribute('aria-current');
          });
          if (status) status.textContent = `현재 ${slides[currentSlideIndex].getAttribute('aria-label')}`;
        };
        const scheduleUpdate = () => {
          if (updateFrame) window.cancelAnimationFrame(updateFrame);
          updateFrame = window.requestAnimationFrame(() => {
            updateFrame = 0;
            updateControls();
            updateCurrentSlide();
          });
        };
        const move = (direction) => {
          const firstSlide = slides[0];
          const gap = parseFloat(getComputedStyle(carousel).columnGap) || 0;
          carousel.scrollBy({
            left: direction * (firstSlide.getBoundingClientRect().width + gap),
            behavior: reducedMotion.matches ? 'auto' : 'smooth',
          });
        };

        previous.addEventListener('click', () => move(-1));
        next.addEventListener('click', () => move(1));
        carousel.addEventListener('keydown', (event) => {
          if (event.target !== carousel || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          move(event.key === 'ArrowLeft' ? -1 : 1);
        });
        carousel.addEventListener('focusin', (event) => {
          const slide = event.target instanceof Element ? event.target.closest('.practice-slide') : null;
          if (slide) focusCarouselSlide(slide);
        });
        carousel.addEventListener('scroll', scheduleUpdate, { passive: true });
        window.addEventListener('resize', scheduleUpdate);
        updateControls();
        updateCurrentSlide();
      });

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
      } else {
        document.querySelectorAll('.reveal').forEach((element) => element.classList.add('is-visible'));
      }
    })();
  </script>
</body>
</html>
