  <header class="site-header">
    <a class="brand" href="{% if absolute_links %}{{ product.site_url }}/{% else %}index.html{% endif %}" aria-label="JLPT MAX Deck 홈">
      <span class="brand-mark" aria-hidden="true"><span class="brand-mark-jlpt">JLPT</span><strong class="brand-mark-max">MAX</strong></span>
      <span class="brand-wordmark">JLPT <b>MAX</b> Deck</span>
    </a>
    <nav aria-label="주요 메뉴">
      <div class="nav-group nav-primary-links" role="group" aria-label="주요 페이지">
        <div class="nav-guide-menu" data-guide-menu data-open="false"{% if current_page in ("getting-started", "install-anki", "update") %} data-current="true"{% endif %}>
          <a class="nav-guide-entry" href="{% if absolute_links %}{{ product.site_url }}/getting-started.html{% else %}getting-started.html{% endif %}"{% if current_page == "getting-started" %} aria-current="page"{% endif %}><span class="nav-label-full">시작 가이드</span><span class="nav-label-compact">시작</span></a>
          <button class="nav-guide-trigger" type="button" aria-label="시작 가이드 하위 메뉴 펼치기" aria-expanded="false" aria-controls="nav-guide-submenu" aria-haspopup="true"><span class="nav-guide-chevron" aria-hidden="true"><svg viewBox="0 0 16 16" focusable="false"><path d="m3.5 5.75 4.5 4.5 4.5-4.5"/></svg></span></button>
          <div class="nav-guide-submenu" id="nav-guide-submenu">
            <a href="{% if absolute_links %}{{ product.site_url }}/install-anki.html{% else %}install-anki.html{% endif %}"{% if current_page == "install-anki" %} aria-current="page"{% endif %}>Anki가 처음이에요</a>
            <a href="{% if absolute_links %}{{ product.site_url }}/getting-started.html#existing-user{% else %}getting-started.html#existing-user{% endif %}">Anki를 이미 사용 중이에요</a>
            <a href="{% if absolute_links %}{{ product.site_url }}/update.html{% else %}update.html{% endif %}"{% if current_page == "update" %} aria-current="page"{% endif %}>JLPT MAX덱 업데이트</a>
          </div>
        </div>
        <a href="{% if absolute_links %}{{ product.site_url }}/study-guide.html{% else %}study-guide.html{% endif %}"{% if current_page == "study-guide" %} aria-current="page"{% endif %} aria-label="덱 학습법"><span class="nav-label-full">덱 학습법</span><span class="nav-label-compact">학습</span></a>
        <a href="{% if absolute_links %}{{ product.site_url }}/kanji.html{% else %}kanji.html{% endif %}"{% if current_page == "kanji" %} aria-current="page"{% endif %} aria-label="한자 확장"><span class="nav-label-full">한자 확장</span><span class="nav-label-compact">한자</span></a>
        <a href="{% if absolute_links %}{{ product.site_url }}/support.html{% else %}support.html{% endif %}"{% if current_page == "support" %} aria-current="page"{% endif %} aria-label="도움말"><span class="nav-label-full">도움말</span><span class="nav-label-compact">도움</span></a>
      </div>
    </nav>
    <a class="nav-action" id="repo-link" href="{{ product.repository_url }}" target="_blank" rel="noopener noreferrer" aria-label="GitHub에서 Star, 새 탭에서 열림"><svg class="nav-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.66.35-1.12.64-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.53a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg><span class="nav-action-label">GitHub에서 Star</span><span class="nav-action-arrow" aria-hidden="true">↗</span></a>
  </header>
  <script>
    (() => {
      const menu = document.querySelector("[data-guide-menu]");
      if (!menu) return;
      const trigger = menu.querySelector(".nav-guide-trigger");
      const submenu = menu.querySelector(".nav-guide-submenu");
      if (!trigger || !submenu) return;

      const setOpen = (open) => {
        menu.dataset.open = String(open);
        trigger.setAttribute("aria-expanded", String(open));
        trigger.setAttribute(
          "aria-label",
          open ? "시작 가이드 하위 메뉴 닫기" : "시작 가이드 하위 메뉴 펼치기",
        );
      };

      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        setOpen(menu.dataset.open !== "true");
      });
      submenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });
      document.addEventListener("click", (event) => {
        if (!menu.contains(event.target)) setOpen(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu.dataset.open === "true") {
          setOpen(false);
          trigger.focus();
        }
      });
    })();
  </script>
