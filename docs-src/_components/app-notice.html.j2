{%- if product.app_launch %}
{%- set launch = product.app_launch %}
{%- set records = launch.records.text.split("{link}") %}
  <link rel="stylesheet" href="{% if absolute_links %}{{ product.site_url }}/{% endif %}assets/app-notice.css">
  <dialog class="app-notice" data-app-notice data-closes-at="{{ product.app_alert.closes_at }}" aria-labelledby="app-notice-title" tabindex="-1">
    <svg class="app-notice-icon" viewBox="0 0 1024 1024" aria-hidden="true">
      <rect width="1024" height="1024" fill="#1B1F2E"/>
      <path transform="translate(180 343) scale(1.23)" fill="#FDFCF9" d="M29.9 93.3Q20.6 93.3 12.8 89.8Q5 86.3 0 79.9L11.8 65.8Q15.6 70.7 19.8 73.3Q24 75.9 28.8 75.9Q41.8 75.9 41.8 60.7V17H9.6V0H62.9V59.5Q62.9 76.5 54.5 84.9Q46.1 93.3 29.9 93.3ZM83.8 91.7V0H105.1V74.4H151.1V91.7ZM163 91.7V0H202.7Q215 0 223.9 4Q232.8 8 237.7 15.5Q242.5 22.9 242.5 33.3Q242.5 43.5 237.7 51Q232.8 58.4 223.9 62.4Q215 66.4 202.7 66.4H174.8L184.2 56.9V91.7ZM184.2 59.2 174.8 49.1H201.5Q211.3 49.1 216.2 44.9Q221 40.7 221 33.3Q221 25.7 216.2 21.5Q211.3 17.3 201.5 17.3H174.8L184.2 7.2ZM277.9 91.7V17.3H248.5V0H328.5V17.3H299.1V91.7Z  M0 272.1V119.2H42.4L103.5 219H81.2L140.6 119.2H183L183.4 272.1H136.5L136 190H143.5L102.8 258.3H80.1L37.8 190H46.9V272.1ZM370.1 272.1 438.2 176.9 438 212.9 372.1 119.2H429.9L468.4 176L443.7 176.2L481.3 119.2H536.7L470.8 210.9V175.1L540 272.1H481L442.6 212.7L466.4 212.5L428.9 272.1Z M 191.7 272.1 L 258.5 119.2 L 309.2 119.2 L 376 272.1 L 322.7 272.1 L 283.4 158.5 L 244.1 272.1 Z M 300 206.6 Q 285.4 214.9 272.3 238.4 L 311.2 238.4 Z"/>
    </svg>
    <h2 id="app-notice-title">{{ launch.title }}</h2>
    <p class="app-notice-body">MAX덱 제작자가 만든 JLPT 단어·한자 앱이에요.</p>
    <p class="app-notice-records">{{ records[0] }}<a href="{{ launch.records.url }}" target="_blank" rel="noopener noreferrer">{{ launch.records.link_text }}</a>{{ records[1] }}</p>
    <a class="app-notice-open" href="{{ product.app_alert.url }}" target="_blank" rel="noopener noreferrer" data-app-notice-open>앱 보러 가기</a>
    <button class="app-notice-close" type="button" data-app-notice-close>닫기</button>
  </dialog>
  <script src="{% if absolute_links %}{{ product.site_url }}/{% endif %}assets/app-notice.js" defer></script>
{%- endif %}
